# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (Production target: https://edunexa.my.id).
APP_URL="https://edunexa.my.id"

# ============================================================================
# FASE 2: OBJECT STORAGE CONFIGURATION (Server-Only Secrets - NEVER expose to VITE_*)
# ============================================================================
# Mode default pengembangan: "local" (menyimpan berkas terisolasi di .data/uploads/<schoolId>/)
# Mode produksi edunexa.my.id: "gcs" (Google Cloud Storage) atau "s3" (S3-Compatible Object Storage)
STORAGE_PROVIDER="local"
GCS_BUCKET_NAME=""
S3_BUCKET_NAME=""
S3_ENDPOINT=""
S3_REGION="ap-southeast-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ============================================================================
# FASE 2: WEB PUSH / VAPID NOTIFICATION CONFIGURATION (RFC 8030)
# ============================================================================
# Jika VAPID_PUBLIC_KEY dan VAPID_PRIVATE_KEY kosong, aplikasi otomatis berjalan
# dalam mode "local_browser_notification_only" tanpa mengklaim push server latar belakang aktif.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@edunexa.my.id"
